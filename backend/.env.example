# Runtime values stored in the Modal Secret named by MODAL_SECRET_NAME.

# API authentication token — clients must send this as a Bearer token
AUTH_TOKEN=

# Google Gemini API key (used for viral moment identification)
GEMINI_API_KEY=

# AWS credentials and storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=
GAMEPLAY_S3_PREFIX=gameplay

# Set these in your local shell before running `modal deploy`.
MODAL_APP_NAME=slayshot
MODAL_SECRET_NAME=slayshot-secret
MODAL_VOLUME_NAME=slayshot-model-cache
