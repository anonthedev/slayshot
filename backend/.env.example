# These secrets are configured via Modal Secrets (modal.Secret.from_name("omen-clipper-secret")).
# For local development / testing, set them as environment variables.

# API authentication token — clients must send this as a Bearer token
AUTH_TOKEN=

# OpenAI API key (used for alternative LLM calls, kept for compatibility)
OPENAI_API_KEY=

# Google Gemini API key (used for viral moment identification)
GEMINI_API_KEY=

# AWS credentials for S3 access (omenclip bucket)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
