# App URLs
APP_URL=http://localhost:3000

# Auth.js and Google OAuth
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=

# Landing-page showcase. Use a JSON array or comma-separated S3 URIs.
# Example: ["s3://your-bucket/showcase/clip-1.mp4","s3://your-bucket/showcase/clip-2.mp4"]
SHOWCASE_S3_URIS=[]

# Modal backend
CLIPPER_ENDPOINT=
MODAL_AUTH_TOKEN=

# YouTube Data API
YOUTUBE_API_KEY=

# Inngest
INNGEST_APP_ID=slayshot
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Polar. Point signed order.paid webhooks at /api/webhooks/polar.
# Checkout success_url uses Polar's {CHECKOUT_ID} placeholder.
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
NEXT_PUBLIC_POLAR_STARTER_PRODUCT_ID=
NEXT_PUBLIC_POLAR_PRO_PRODUCT_ID=
